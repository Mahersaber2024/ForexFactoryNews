# Website + API, generated by scripts/install.sh from website/nginx/site.conf.template.
# Placeholders: __DOMAIN__ (or _ for IP access), __ROOT__ (website/content), __FLASK_PORT__.
# HTTPS is added afterwards by: certbot --nginx -d DOMAIN --redirect
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __ROOT__;
    index index.html;
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    server_tokens off;

    # Block malicious IPs
    deny 204.76.203.18;
    deny 185.242.226.102;

    # Rate limiting
    limit_req zone=site_rl burst=20 nodelay;

    # Block suspicious paths (whole path segments only, so e.g. /templates.zip still works)
    location ~* (^|/)(huhu|admin|wp-admin|wp-includes|backup|tmp|temp|logs|config|\.env|\.git|\.svn)(/|$) {
        return 444;
    }

    # Block sensitive files
    location ~* \.(ini|log|sh|bash|sql|db|bak|backup|swp|swo|~)$ {
        return 444;
    }

    # Block malicious User-Agents
    if ($http_user_agent ~* (python-requests|curl|wget|nikto|sqlmap|nmap|masscan|zgrab|httpx)) {
        return 444;
    }

    # Main page
    location = / {
        try_files $uri $uri/ /index.html;
    }

    # Download page
    location = /download {
        try_files $uri $uri/ /downloadpage.html;
    }

    # EA build files: JSON directory listing so downloadpage.html detects files automatically.
    # Files here get replaced from the bot, so browsers revalidate instead of caching for a year.
    location /assets/downloads/ {
        autoindex on;
        autoindex_format json;
        add_header Cache-Control "no-cache";
        location ~ /\. {
            deny all;
        }
    }

    # Assets files
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        location ~ /\. {
            deny all;
        }
    }

    # Other files
    location / {
        try_files $uri $uri.html $uri/ /index.html;
        autoindex off;
    }

    # Flask API
    location /api/ {
        proxy_pass http://127.0.0.1:__FLASK_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=site_rl burst=10 nodelay;
    }

    error_page 403 404 405 500 502 503 504 /error.html;
    location = /error.html {
        root __ROOT__;
        internal;
    }
}
